[Unit]
Description=Electrical Testbench Mock CAN Sender
After=network.target can0-setup.service
Requires=can0-setup.service

[Service]
Type=simple
User=sunpi
WorkingDirectory=/home/sunpi/electrical-testbench
Environment=PYTHONPATH=/home/sunpi/electrical-testbench
ExecStart=/home/sunpi/electrical-testbench/venv/bin/python3 send_mock_all.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
